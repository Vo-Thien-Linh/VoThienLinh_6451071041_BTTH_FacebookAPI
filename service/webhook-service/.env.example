
# NOTE: Ứng dụng chỉ đọc file `.env` khi chạy. File này là MẪU để copy thành `.env`.

PORT=3001
VERIFY_TOKEN=linhfacebookapi
APP_SECRET=

# Kafka
KAFKA_BROKER=localhost:19092
KAFKA_TOPIC=raw_events

# Facebook
ACCESS_TOKEN=
PAGE_ID=
FB_GRAPH_VERSION=v23.0
FB_TIMEOUT_MS=8000

# Core Service (consumer)
KAFKA_TOPIC_IN=raw_events
KAFKA_TOPIC_RESULTS=moderation_results
KAFKA_TOPIC_MANUAL_REVIEW=manual_review
KAFKA_TOPIC_FAILED=send_failed
KAFKA_GROUP_ID=core-service-v1
KAFKA_FROM_BEGINNING=false

PARTITIONS_CONCURRENTLY=1
MAX_MESSAGES_PER_BATCH=50
ENABLE_FACEBOOK_ACTIONS=true

# Facebook moderation action for spam comments: hide | delete
FB_SPAM_ACTION=hide

# AI (LLM provider)
# Chọn 1 trong: openai | gemini | claude
AI_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Claude
CLAUDE_API_KEY=
# AI_MODEL=claude-3-5-sonnet-latest

AI_TIMEOUT_MS=15000

# AI auto-reply
# - template: dùng câu trả lời mẫu theo intent
# - llm: dùng LLM sinh câu trả lời
AI_REPLY_MODE=llm

# (tuỳ chọn) trả lời rộng như chat (bao gồm cả câu chào/intent other)
# - true: bot sẽ trả lời cả các comment chung chung như "shop ơi", và nhiều câu hỏi ngoài intent mua hàng
# - false: chỉ trả lời khi có nội dung rõ ràng theo rule/prompt
AI_REPLY_GENERAL_CHAT=false

# (tuỳ chọn) model riêng cho phần trả lời; mặc định dùng AI_MODEL
# Lưu ý: đây là TÊN MODEL (vd: gemini-2.5-flash / gpt-4o-mini), không phải provider (gemini/openai)
AI_REPLY_MODEL=

AI_REPLY_MAX_CHARS=400
SHOP_NAME=Shop

# Spam
MALICIOUS_DOMAINS=

# Spam: xử lý comment có link
# - true: comment chứa link sẽ bị coi là spam nhẹ (có thể dẫn tới hide/delete tuỳ FB_SPAM_ACTION)
# - false: cho phép link bình thường (phù hợp shop bán hàng)
SPAM_TREAT_LINK_AS_LIGHT=false

# Spam (rate limit)
COMMENT_RATE_WINDOW_MS=60000
COMMENT_RATE_THRESHOLD=3
